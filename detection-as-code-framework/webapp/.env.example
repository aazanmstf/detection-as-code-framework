# Copy this file to webapp/.env for local development.
# NEVER commit a real .env file - it is already in .gitignore.
#
# In production, set these as real environment variables on the host /
# platform, not via a .env file shipped in the repo.

# development | production | testing
FLASK_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset in development - a random ephemeral key is generated
# automatically (sessions just won't survive a restart).
SECRET_KEY=

# Where the SQLite database file lives. Defaults to webapp/instance/webapp.db
DATABASE_PATH=

# Max upload size in bytes. Defaults to 102400 (100 KB), which is generous
# for a single Sigma rule.
MAX_UPLOAD_BYTES=102400

# Set to true only when served over HTTPS (required in production; the
# ProductionConfig forces this on regardless of this variable).
SESSION_COOKIE_SECURE=false

# How long a login session stays valid, in seconds. Default: 8 hours.
SESSION_LIFETIME_SECONDS=28800
